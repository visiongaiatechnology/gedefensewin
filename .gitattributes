* text=auto eol=lf
*.go text eol=lf
*.js text eol=lf
*.css text eol=lf
*.html text eol=lf
*.md text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
# Preserve exact signed PowerShell bytes; newline conversion invalidates Authenticode.
*.ps1 -text
*.psm1 -text
*.cmd text eol=crlf
*.png binary
*.jpg binary
*.bmp binary
*.ico binary

